{
	"name": "@recast/media",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"description": "Shared media-processing layer for Recast: wraps MediaBunny and the modern web platform (WebCodecs, Web Workers, AudioWorklet, IndexedDB, Streams) behind one opinionated, high-level API.",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./mediabunny": {
			"types": "./src/mediabunny.ts",
			"default": "./src/mediabunny.ts"
		},
		"./playback": {
			"types": "./src/playback/index.ts",
			"default": "./src/playback/index.ts"
		},
		"./playback/worker": {
			"types": "./src/playback/worker.ts",
			"default": "./src/playback/worker.ts"
		}
	},
	"dependencies": {
		"@breezystack/lamejs": "^1.2.7",
		"fflate": "^0.8.3",
		"gifenc": "^1.0.3",
		"mediabunny": "^1.52.0"
	},
	"peerDependencies": {
		"svelte": "^5.56.1"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"esbuild": "^0.28.1",
		"svelte": "^5.56.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"build": "exit 0",
		"check": "tsc --noEmit -p tsconfig.json",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest"
	}
}
