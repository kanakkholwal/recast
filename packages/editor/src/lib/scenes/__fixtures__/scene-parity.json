				"intensity": 0.6
			},
			"samples": [
				{ "t": 0, "opacity": 1, "translateX": -0.6, "translateY": 0, "scale": 1 },
				{ "t": 1, "opacity": 1, "translateX": -0.3, "translateY": 0, "scale": 1 },
