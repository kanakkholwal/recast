{
	"$schema": "node_modules/wrangler/config-schema.json",

	// Top level IS the preview environment: `wrangler deploy` with no `--env` targets it.
	// Production overrides live under `env.production` and are selected with `--env production`.
	"name": "recast-web-app",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-01",

	// postgres.js needs node:net/node:stream; without this flag the Worker fails at import time.
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},

	"observability": {
		"enabled": true
	},

	// Postgres is reached directly on Neon's POOLED endpoint, which is why the client sets `prepare: false` (see lib/db).
	// Non-secret, per-environment. Secrets, `DATABASE_URL` included, go through `wrangler secret put`, never this file.
	"vars": {
		"PUBLIC_APP_NAME": "Recast",
		"PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
		"PUBLIC_POSTHOG_UI_HOST": "https://us.posthog.com",
		"EMAIL_FROM": "Recast <hello@recast.li>"
	},

	"env": {
		"production": {
			"name": "recast-web",
			// `vars`, `routes` and every binding are NOT inherited by a named environment; repeat them.
			"vars": {
				"PUBLIC_APP_URL": "https://recast.li"
			},
			"routes": [
				{
					"pattern": "recast.li",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true
			}
		},
		"preview": {
			"name": "recast-web-preview",
			"vars": {
				"PUBLIC_APP_URL": "https://preview.recast.li"
			},
			"routes": [
				{
					"pattern": "preview.recast.li",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true
			}
		}
	}
}
