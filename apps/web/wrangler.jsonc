{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Top level is production (`wrangler deploy` → recast-web); preview lives under env.preview
	// (`--env preview` → recast-web-preview). Both names explicit so wrangler never auto-suffixes.
	"name": "recast-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-01",
	// postgres.js needs node:net/node:stream; without this flag the Worker fails at import time.
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Postgres is reached directly on Neon's POOLED endpoint, which is why the client sets `prepare: false` (see lib/db).
	// Non-secret, per-environment. Secrets, `DATABASE_URL` included, go through `wrangler secret put`, never this file.
	"vars": {
		"PUBLIC_APP_NAME": "Recast",
		"PUBLIC_APP_URL": "https://recast.li",
		"PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
		"PUBLIC_POSTHOG_UI_HOST": "https://us.posthog.com",
		"EMAIL_FROM": "Recast <hello@recast.li>",
		"NODE_ENV": "production",
		"POLAR_SERVER": "sandbox",
		"STORAGE_PROVIDER": "azure",
		"TRUSTED_ORIGINS": "https://recast.li,https://www.recast.li,https://recast.nexonauts.com,https://recast-web.vercel.app,https://preview.recast.li"
	},
	"routes": [
		{
			"pattern": "recast.li",
			"custom_domain": true
		}
	],
	"env": {
		// A named env inherits main/assets/compatibility but NOT name, vars or routes; repeat them.
		"preview": {
			"name": "recast-web-preview",
			"vars": {
				"PUBLIC_APP_NAME": "Recast",
				"PUBLIC_APP_URL": "https://preview.recast.li",
				"PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
				"PUBLIC_POSTHOG_UI_HOST": "https://us.posthog.com",
				"EMAIL_FROM": "Recast <hello@recast.li>"
			},
			"routes": [
				{
					"pattern": "preview.recast.li",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true
			},
			"hyperdrive": [
				{
					"binding": "recast-preview",
					"id": "cedd359e3f774a96bcc229477cb55eb1",
					"localConnectionString": "postgresql://localhost:5432/recast"
				}
			]
		}
	},
	// localConnectionString is local-emulation only (build prerender + wrangler dev); production uses the id.
	"hyperdrive": [
		{
			"binding": "recast-prod",
			"id": "97c3cec1775041329abf824a4a37522b",
			"localConnectionString": "postgresql://localhost:5432/recast"
		}
	]
}