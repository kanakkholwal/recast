{
	"name": "recast-desktop",
	"private": true,
	"version": "0.0.0-0",
	"type": "module",
	"scripts": {
		"sync:changelog": "node ../../scripts/sync-desktop-changelog.mjs",
		"sync:assets": "node ../../scripts/sync-screenshot-assets.mjs",
		"ui:dev": "pnpm sync:changelog && pnpm sync:assets && vite dev",
		"ui:build": "pnpm sync:changelog && pnpm sync:assets && vite build",
		"ui:preview": "vite preview",
		"tauri": "tauri",
		"dev": "tauri dev",
		"build": "tauri build",
		"build:debug": "tauri build --debug",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
		"lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"lint:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --fix --allow-dirty --allow-staged -- -D warnings",
		"lint:no-engine": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --no-default-features -- -D warnings",
		"test": "pnpm test:unit && pnpm test:rust",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
		"test:rust:watch": "cargo watch -x \"test --manifest-path src-tauri/Cargo.toml --lib\"",
		"clean:cargo": "cd src-tauri && cargo clean"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@recast/analytics": "workspace:*",
		"@recast/captions": "workspace:*",
		"@recast/design": "workspace:*",
		"@recast/editor": "workspace:*",
		"@recast/icons": "workspace:*",
		"@recast/media": "workspace:*",
		"@recast/render": "workspace:*",
		"@recast/ui": "workspace:*",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.1",
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/cli": "^2.10.1",
		"@types/node": "^25.6.0",
		"shadcn-svelte": "^1.2.7",
		"sharp": "^0.34.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.4.2",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "^8.1.4",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@choochmeque/tauri-plugin-sharekit-api": "^0.3.1",
		"@fontsource-variable/geist-mono": "^5.2.7",
		"@fontsource-variable/google-sans": "^5.2.1",
		"@phosphor-icons/core": "2.1.1",
		"@recast/icons": "workspace:*",
		"@recast/player": "workspace:*",
		"@tabler/icons-svelte": "^3.44.0",
		"@tauri-apps/plugin-deep-link": "2.4.9",
		"@tauri-apps/plugin-dialog": "2.6.0",
		"@tauri-apps/plugin-log": "~2.8.0",
		"@tauri-apps/plugin-notification": "~2.3.3",
		"@tauri-apps/plugin-opener": "~2.5.4",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-process": "~2.3.0",
		"@tauri-apps/plugin-updater": "~2.10.1",
		"@tauri-controls-v2/svelte": "^0.4.4",
		"@unpic/svelte": "^1.0.1",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.1.0"
	}
}
