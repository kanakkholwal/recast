{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/.svelte-kit",
			"!**/.turbo",
			"!**/target",
			"!**/src-tauri/target",
			"!packages/engine/wasm",
			"!**/src-tauri/gen",
			"!**/pnpm-lock.yaml",
			"!**/*.min.js",
			"!apps/desktop/src/app.css",
			"!apps/web/src/app.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"formatWithErrors": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"json": {
		"formatter": {
			"enabled": false
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": false
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@lucide/svelte": "Import from @recast/icons instead. The Lucide → Tabler barrel is curated in packages/icons/src/tabler/.",
							"@tabler/icons-svelte": "Import from @recast/icons instead. The Tabler → Lucide-shaped barrel is curated in packages/icons/src/tabler/.",
							"@phosphor-icons/svelte": "Reserved for future; use @recast/icons/ai for Phosphor duotone accents instead.",
							"@phosphor-icons/svelte-duotone": "Use @recast/icons/ai for Phosphor duotone accents instead.",
							"@phosphor-icons/core": "Vendored — do not import directly. AI accents live under @recast/icons/ai.",
							"@phosphor-icons/web": "Use @recast/icons/ai for Phosphor duotone accents instead.",
							"mediabunny": "Import from @recast/media instead. Direct mediabunny imports are forbidden outside packages/media (see packages/media/REQUIREMENTS.md §5).",
							"gifenc": "Import from @recast/media instead. The gifenc encoder is owned by @recast/media's encoders module.",
							"@breezystack/lamejs": "Import from @recast/media instead. The MP3 encoder is owned by @recast/media's encoders module.",
							"fflate": "Import from @recast/media instead. The zip helper is owned by @recast/media's encoders module."
						}
					}
				},
				"noHexColors": "error",
				"noUselessElse": "error",
				"noNonNullAssertion": "error",
				"noInferrableTypes": "error",
				"noParameterAssign": "error",
				"noNestedTernary": "warn",
				"noYodaExpression": "error",
				"useCollapsedIf": "error",
				"useCollapsedElseIf": "error",
				"useConst": "error",
				"useTemplate": "error",
				"useShorthandAssign": "error",
				"useSingleVarDeclarator": "error",
				"useImportType": "error",
				"useExportType": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 15
					}
				},
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": {
						"maxLines": 120
					}
				},
				"useMaxParams": {
					"level": "warn",
					"options": {
						"max": 5
					}
				},
				"noUselessFragments": "error",
				"noUselessTernary": "error",
				"noImplicitCoercions": "error",
				"useOptionalChain": "error",
				"useArrowFunction": "error",
				"useFlatMap": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noDoubleEquals": "error",
				"noShadow": "error",
				"noEmptyBlockStatements": "error",
				"noTsIgnore": "error",
				"noVar": "error",
				"noRedeclare": "error",
				"noUnusedExpressions": "error",
				"noDuplicateProperties": "error",
				"noDuplicateCustomProperties": "error",
				"noDuplicateFontNames": "error",
				"noShorthandPropertyOverrides": "error",
				"useAwait": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedPrivateClassMembers": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noDelete": "error"
			},
			"nursery": {
				"noSvelteLegacyConst": "error",
				"noSvelteUnnecessaryStateWrap": "error",
				"useSvelteRequireEachKey": "error",
				"noDuplicateSelectors": "error",
				"noUnnecessaryTemplateExpression": "error",
				"noUselessTypeConversion": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/desktop/src/constants/changelog.ts"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					},
					"style": {
						"noHexColors": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/design/src/index.css"],
			"linter": {
				"rules": {
					"style": {
						"noHexColors": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.spec.ts", "**/test/**", "**/__tests__/**"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/icons/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/media/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/desktop/src/lib/timeline/filmstrip-worker.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
