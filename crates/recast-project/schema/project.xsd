                <xs:enumeration value="false"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="music">
    <xs:annotation>
      <xs:documentation>A clip placed on the OUTPUT timeline.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="src" type="xs:string" use="required"/>
      <xs:attribute name="axis">
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:token">
                <xs:enumeration value="output"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="at">
        <xs:annotation>
          <xs:documentation>Output seconds.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="offset">
        <xs:annotation>
          <xs:documentation>Seconds into the file.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="dur">
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="gain">
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:decimal">
                <xs:minInclusive value="0"/>
                <xs:maxInclusive value="1"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="muted">
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:token">
                <xs:enumeration value="true"/>
                <xs:enumeration value="false"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="fadeIn">
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="fadeOut">
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="loop">
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:token">
                <xs:enumeration value="true"/>
                <xs:enumeration value="false"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="duck">
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:token">
                <xs:enumeration value="true"/>
                <xs:enumeration value="false"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="provider" type="xs:string"/>
      <xs:attribute name="track" type="xs:string">
        <xs:annotation>
          <xs:documentation>Provider track id.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="attribution" type="xs:string"/>
      <xs:attribute name="license" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="sequence">
    <xs:annotation>
      <xs:documentation>An authored composition: items on the OUTPUT clock, with no recording underneath. Their `at` and `dur` are output seconds, unlike the same elements inside &lt;annotations&gt;.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="img"/>
        <xs:element ref="text"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string"/>
      <xs:attribute name="transition">
        <xs:annotation>
          <xs:documentation>How one item gives way to the next.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:token">
                <xs:enumeration value="none"/>
                <xs:enumeration value="dissolve"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="transitionDur">
        <xs:annotation>
          <xs:documentation>How long a transition takes, in output seconds.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:decimal">
                <xs:minInclusive value="0"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="graphic">
    <xs:annotation>
      <xs:documentation>A component instance; other attributes are its parameters.</xs:documentation>
    </xs:annotation>
