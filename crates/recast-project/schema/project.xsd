          <xs:documentation>name@version</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="at">
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="dur">
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:anyAttribute namespace="##any" processContents="skip"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="shader">
    <xs:annotation>
      <xs:documentation>A component instance painted over the screen card; its uniforms are the component's parameters.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="uniform"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="component" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>name@major.minor of a registered screen component.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="at">
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="dur">
        <xs:simpleType>
          <xs:union memberTypes="xs:decimal varRef"/>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="uniform">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="editor">
    <xs:annotation>
      <xs:documentation>UI state the engine ignores.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="layout">
        <xs:simpleType>
          <xs:union memberTypes="varRef">
            <xs:simpleType>
              <xs:restriction base="xs:token">
                <xs:enumeration value="auto"/>
                <xs:enumeration value="crop"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:union>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="preset" type="xs:string"/>
      <xs:attribute name="motionTone" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="unknowns">
    <xs:annotation>
      <xs:documentation>Keys a migration could not place; preserved, never meaningful.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="unknown"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="unknown">
    <xs:complexType>
      <xs:attribute name="key" type="xs:string" use="required"/>
      <xs:attribute name="json" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
