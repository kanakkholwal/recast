
say() { echo "[pre-commit] $*" >&2; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0


dirty=$(git diff --name-only)

restage() {
  while IFS= read -r file; do
    [ -n "$file" ] && [ -f "$file" ] || continue
    if printf '%s\n' "$dirty" | grep -Fxq "$file"; then
      say "$file has unstaged edits — formatted, not re-staged"
      continue
    fi
    git add -- "$file"
  done
}

rust_files=$(printf '%s\n' "$staged" | grep -E '^apps/desktop/src-tauri/.*\.rs$' || true)
if [ -n "$rust_files" ]; then
  say "rustfmt…"
  edition=$(grep -m1 '^edition' apps/desktop/src-tauri/Cargo.toml | cut -d'"' -f2)
  if ! printf '%s\n' "$rust_files" | xargs rustfmt --edition "${edition:-2021}"; then
    say "rustfmt failed. Run: pnpm fmt:rust"
    exit 1
  fi
  printf '%s\n' "$rust_files" | restage
fi

web_files=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|jsx|svelte|jsonc)$' || true)
if [ -n "$web_files" ]; then
  say "biome format…"
 
  if ! pnpm exec biome format --write --staged --no-errors-on-unmatched . >&2; then
    say "biome could not format some files. Run: pnpm fmt:js"
    exit 1
  fi
  printf '%s\n' "$web_files" | restage
fi

# # Lint gates, staged-scoped. 
if [ -n "$web_files" ]; then
  say "biome lint…"
  if ! pnpm exec biome lint --staged --no-errors-on-unmatched . >&2; then
    say "biome lint failed. Fix, or run: pnpm lint:js:fix"
    exit 1
  fi
fi

if ! node scripts/check-comments.mjs --staged >&2; then
  exit 1
fi
