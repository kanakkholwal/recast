{
	"$schema": "../../schema/extension.source.schema.json",
	"id": "caption-themes",
	"name": "Caption Themes",
	"version": "1.1.0",
	"author": "Recast",
	"description": "Extra caption looks for overlay and burned-in captions — a neon karaoke pop, a newsroom lower-third, and a minimal line.",
	"kind": "asset-pack",
	"permissions": [],
	"contributes": {
		"captionPresets": [
			{
				"id": "neon",
				"label": "Neon",
				"description": "Cyan caps, word pop",
				"fontFamily": "'Anton', sans-serif",
				"fontWeight": 700,
				"fontSizePct": 6.5,
				"position": "center",
				"align": "center",
				"offsetPct": 0,
				"color": "#22d3ee",
				"mutedColor": "#155e75",
				"uppercase": true,
				"letterSpacing": 0.02,
				"background": "none",
				"backgroundColor": "#000000",
				"backgroundOpacity": 0,
				"boxPaddingXEm": 0.7,
				"boxPaddingYEm": 0.32,
				"boxRadiusEm": 0.5,
				"lineHeight": 1.2,
				"outlineWidth": 5,
				"outlineColor": "#0f172a",
				"maxLines": 1,
				"maxCharsPerLine": 28,
				"animation": {
					"chunk": "word",
					"chunkSize": 1,
					"emphasis": "scale",
					"emphasisColor": "#22d3ee",
					"highlight": "none",
					"entrance": "pop",
					"entranceMs": 150,
					"holdGaps": true
				}
			},
			{
				"id": "newsroom",
				"label": "Newsroom",
				"description": "Serif lower-third bar",
				"fontFamily": "Georgia, 'Times New Roman', serif",
				"fontWeight": 600,
				"fontSizePct": 4,
				"position": "bottom",
				"align": "left",
				"offsetPct": 7,
				"color": "#ffffff",
				"mutedColor": "#94a3b8",
				"uppercase": false,
				"letterSpacing": 0,
				"background": "box",
				"backgroundColor": "#0b1f3a",
				"backgroundOpacity": 90,
				"boxPaddingXEm": 0.8,
				"boxPaddingYEm": 0.3,
				"boxRadiusEm": 0.25,
				"lineHeight": 1.35,
				"outlineWidth": 0,
				"outlineColor": "#000000",
				"maxLines": 2,
				"maxCharsPerLine": 46,
				"animation": {
					"chunk": "phrase",
					"chunkSize": 6,
					"emphasis": "none",
					"emphasisColor": "#ffffff",
					"highlight": "progressive",
					"entrance": "slide",
					"entranceMs": 125,
					"holdGaps": true
				}
			},
			{
				"id": "minimal",
				"label": "Minimal",
				"description": "Thin, no backing",
				"fontFamily": "'Inter', sans-serif",
				"fontWeight": 500,
				"fontSizePct": 3.6,
				"position": "bottom",
				"align": "center",
				"offsetPct": 5,
				"color": "#ffffff",
				"mutedColor": "#d4d4d8",
				"uppercase": false,
				"letterSpacing": 0,
				"background": "soft",
				"backgroundColor": "#000000",
				"backgroundOpacity": 50,
				"boxPaddingXEm": 0.7,
				"boxPaddingYEm": 0.32,
				"boxRadiusEm": 0.6,
				"lineHeight": 1.35,
				"outlineWidth": 0,
				"outlineColor": "#000000",
				"maxLines": 2,
				"maxCharsPerLine": 42,
				"animation": {
					"chunk": "phrase",
					"chunkSize": 6,
					"emphasis": "none",
					"emphasisColor": "#ffffff",
					"highlight": "progressive",
					"entrance": "fade",
					"entranceMs": 125,
					"holdGaps": true
				}
			}
		]
	},
	"assets": []
}
